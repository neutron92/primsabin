```

}

/* Continue for other elements… */
}

/* Animation Keyframes */
@keyframes slide-in {
0% {
opacity: 0;
transform: translateX(-50px);
}
100% {
opacity: 1;
transform: translateX(0);
}
}

@keyframes slide-up {
0% {
opacity: 0;
transform: translateY(50px);
}
100% {
opacity: 1;
transform: translateY(0);
}
}

