
/* Custom Spacing Variables */
@theme {
  /* Spacing Extensions */
  --spacing-100: 25rem;
  --spacing-header-height: 75px;
  --spacing-mb-header-height: 45px;
  --spacing-12\.5: 50px;
  --spacing-18: 75px;
  --spacing-desktop: calc(100vh - 75px - 40px);
  --spacing-desktop-if: calc(100vh - 75px - 80px);
  --spacing-desktop-if-mb: calc(100vh - 75px - 156px);
  --spacing-desktop-if-md: calc(100vh - 75px - 156px);
  --spacing-desktop-if-lg: calc(100vh - 75px - 186px);
  --spacing-mobile: calc(100vh - 45px);

  /* Colors */
  --color-green-bnp: #39ac7f;
  --color-base-light: #1eb3a0;
  --color-acid-green: #caf939;
  --color-blue-400: #569cfb;
  --color-body: #43435c;
  --color-dark: #14142b;
  --color-gray-200: #e8e9f3;
  --color-gray-300: #cacde3;
  --color-gray-400: #a0a3bd;
  --color-gray-500: #656887;
  --color-gray-700: #43435c;
  --color-gray-900: #14142b;
  --color-light-gray: #f8f4f4;
  --color-light-gray-200: #626262;
  --color-emerald-100: #ecf7f5;
  --color-emerald-200: #daefec;
  --color-emerald-lime: #8fff6d;
  --color-emerald-lime-light: #8fff6d7d;
  --color-light: #f6f6fb;
  --color-main-color: #1625ab;
  --color-main-color-hover: #1a2cc9;
  --color-red-100: #fcf1ee;
  --color-red-200: #fae4e1;
  --color-red-500: #d80800;
  --color-red-600: #be3f23;
  --color-red-error: #715959;
  --color-black-light: #1d1d1b;
  --color-to-rename: #715959;
  --color-content-bg-black: #2a3631;

  /* Font Families */
  --font-family-bnp-type: BnppType;
  --font-family-bnp-sans-condensed-bold: BnpSansCondensedBold;
  --font-family-bnp-sans-condensed-extra-bold: BnpSansCondensedExtraBold;
  --font-family-bnp-sans-condensed-regular: BnpSansCondensedRegular;
  --font-family-bnp-type-bold: BnppTypeBold;
  --font-family-bnpp-type-regular: BnppTypeRegular;
  --font-family-bnp-sans: BnppSans;
  --font-family-bnpp-sans-bold: BnppSansBold;
  --font-family-open-sans: "Open Sans, Regular";
  --font-family-open-sans-regular: OpenSansRegular;
  --font-family-open-sans-bold: OpenSansBold;
  --font-family-helvica-neue: "Helvetica Neue";

  /* Font Sizes */
  --font-size-2\.5xl: 1.75rem;

  /* Line Heights */
  --line-height-loose: 1.8;

  /* Box Shadows */
  --box-shadow-card: 0px 8px 38px -28px rgba(8, 14, 71, 0.75);
  --box-shadow-main-color: 0px 4px 34px 0px rgba(22, 37, 171, 0.25);

  /* Background Images */
  --background-image-hero-image: url('/images/hero-image.jpg');

  /* Z-Index */
  --z-index--1: -1;

  /* Animations */
  --animate-slide-r: slide-r-in 1s ease-in-out;
  --animate-slide-l: slide-l-in 1s ease-in-out;
}

/* Keyframes */
@keyframes slide-r-in {
  0% {
    opacity: 0;
    transform: translateX(-50%);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slide-l-in {
  0% {
    opacity: 0;
    transform: translateX(50%);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Typography Prose Styles */
@layer components {
  .prose {
    & img {
      margin: 0;
    }

    & h2 {
      font-size: 26px;
      font-family: BnpSansCondensedBold;
      line-height: 34px;
      letter-spacing: 0.26px;
      color: #626262;
      margin-top: 0;
      margin-bottom: 0;
      font-weight: unset;
    }

    & h3 {
      font-size: 20px;
      font-family: BnpSansCondensedBold;
      line-height: 24px;
      letter-spacing: 0;
      color: #626262;
      margin-top: 0;
      margin-bottom: 0;
      font-weight: unset;
    }

    & h4 {
      font-size: 14px;
      font-family: OpenSansBold;
      font-weight: bold;
      line-height: 26px;
      letter-spacing: 0.13px;
      color: #626262;
      margin-top: 0;
      margin-bottom: 0;
    }

    & h5 {
      font-size: 14px;
      font-family: BnpSansCondensedBold;
      line-height: 14px;
      letter-spacing: 0;
      color: #626262;
      margin-top: 0;
      margin-bottom: 0;
      font-weight: unset;
    }

    & p {
      font-size: 14px;
      font-family: OpenSansRegular;
      line-height: 26px;
      letter-spacing: 0;
      color: #626262;
      margin-top: 0;
    }

    & a {
      font-size: 14px;
      font-family: OpenSansRegular;
      line-height: 26px;
      letter-spacing: 0;
      color: black;
    }

    & i {
      font-size: 14px;
      font-family: OpenSansRegular;
      line-height: 26px;
      letter-spacing: 0;
      color: #626262;
    }

    & u {
      font-family: OpenSansRegular;
      font-size: 14px;
      line-height: 28px;
      letter-spacing: 0;
    }

    & strong {
      font-size: 14px;
      font-family: OpenSansBold;
      line-height: 26px;
      letter-spacing: 0;
      color: #626262;
    }

    & li {
      font-size: 14px;
      font-family: OpenSansRegular;
      line-height: 26px;
      letter-spacing: 0;
      color: #626262;
    }

    & td {
      font-size: 14px;
      font-family: OpenSansRegular;
      line-height: 26px;
      letter-spacing: 0;
      color: #626262;
    }

    & figure.image figcaption {
      font-size: 14px !important;
      font-family: BnpSansCondensedRegular;
      line-height: 18px !important;
      letter-spacing: 0.17px;
      color: #626262;
      margin-top: 15px;
      margin-bottom: 0;
      font-weight: unset;
    }

    /* Simple Quote Styles - Small */
    & .simple-quote {
      background-color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 25px 25px 25px;
      padding-top: 5rem;
      font-size: 18px;
      font-family: bnpSansCondensedRegular;
      line-height: 23px;
      letter-spacing: 0.24px;
    }

    & .simple-quote blockquote {
      position: relative;
      color: #3c3145;
      border-left-width: 0;
      font-size: 20px;
      font-family: bnpSansCondensedRegular;
      line-height: 26px;
      letter-spacing: 0.16px;
      padding: 0 !important;
      text-align: center;
    }

    & .simple-quote blockquote::before {
      content: url(/svg/quotes.svg);
      position: absolute;
      top: -2.5rem;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 42px;
      height: 29px;
    }

    & .simple-quote figcaption {
      margin-top: 26px;
      font-size: 16px;
      font-family: bnpSansCondensedRegular;
      line-height: 20px;
      letter-spacing: 0.14px;
    }
  }

  /* Medium Breakpoint Prose Styles */
  @media (min-width: 768px) {
    .prose {
      & h2 {
        font-size: 30px;
        line-height: 36px;
        letter-spacing: 0.24px;
      }

      & h3 {
        font-size: 24px;
        line-height: 30px;
        letter-spacing: 0;
      }

      & h4 {
        font-size: 16px;
        line-height: 28px;
        letter-spacing: 0;
      }

      & h5 {
        font-size: 18px;
        line-height: 24px;
        letter-spacing: 0;
      }

      & p {
        font-size: 16px;
        line-height: 28px;
        letter-spacing: 0;
      }

      & a {
        font-size: 16px;
        line-height: 26px;
        letter-spacing: 0;
      }

      & i {
        font-size: 16px;
        line-height: 26px;
        letter-spacing: 0;
      }

      & u {
        font-size: 16px;
        line-height: 28px;
        letter-spacing: 0;
      }

      & strong {
        font-size: 16px;
        line-height: 28px;
        letter-spacing: 0;
      }

      & li {
        font-size: 16px;
        line-height: 28px;
        letter-spacing: 0;
      }

      & td {
        font-size: 16px;
        line-height: 28px;
        letter-spacing: 0;
      }

      & figure.image figcaption {
        font-size: 18px !important;
        line-height: 23px !important;
        letter-spacing: 0;
        margin-top: 20px;
      }

      /* Simple Quote Styles - Medium */
      & .simple-quote {
        padding: 40px 80px 28px 80px;
        padding-top: 5rem;
      }

      & .simple-quote blockquote {
        font-size: 24px;
        line-height: 30px;
        letter-spacing: 0.19px;
      }

      & .simple-quote figcaption {
        font-size: 18px;
        line-height: 23px;
        letter-spacing: 0.14px;
      }
    }
  }
}

