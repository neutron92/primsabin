/* src/styles/tailwind.css */
@import "tailwindcss";
@plugin "@tailwindcss/typography";

/* --- SAFELIST: must be a single quoted string --- */
@source inline("text-[#2A3631] text-[#ffffff] text-white bg-[#E2F3EC] bg-[#84D6B6] bg-[#127D54] bg-[#B2E5D1] bg-[#D2368E] bg-[#425465] bg-[#F9DE4B]");

/* THEME TOKENS */
@theme {
  /* spacing tokens (converted 12.5 -> 12-5 for valid names) */
  --spacing-100: 25rem;
  --spacing-headerHeight: 75px;
  --spacing-mbHeaderHeight: 45px;
  --spacing-12-5: 50px;
  --spacing-18: 75px;
  --spacing-desktop: calc(100vh - 75px - 40px);
  --spacing-desktop-if: calc(100vh - 75px - 80px);
  --spacing-desktop-if-mb: calc(100vh - 75px - 156px);
  --spacing-desktop-if-md: calc(100vh - 75px - 156px);
  --spacing-desktop-if-lg: calc(100vh - 75px - 186px);
  --spacing-mobile: calc(100vh - 45px);

  /* colors (follow tailwind namespace pattern so utilities are generated) */
  --color-greenBnp: #39ac7f;
  --color-baseLight: #1eb3a0;
  --color-acid-green: #CAF939;
  --color-blue-400: #569CFB;
  --color-body: #43435C;
  --color-dark: #14142B;

  --color-gray-200: #E8E9F3;
  --color-gray-300: #CACDE3;
  --color-gray-400: #A0A3BD;
  --color-gray-500: #656887;
  --color-gray-700: #43435C;
  --color-gray-900: #14142B;

  --color-lightGray: #F8F4F4;
  --color-lightGray200: #626262;
  --color-emerald-100: #ECF7F5;
  --color-emerald-200: #daefec;
  --color-lime: #8fff6d;
  --color-limeLight: #8fff6d7d;
  --color-light: #F6F6FB;
  --color-main-color: #1625AB;
  --color-main-color-hover: #1A2CC9;

  /* red family: ensure numeric shade so tailwind generates bg-red-500 etc. */
  --color-red-100: #FCF1EE;
  --color-red-200: #fae4e1;
  --color-red-500: #D80800;
  --color-red-600: #BE3F23;
  /* previously 'error' token renamed to a numeric shade to generate utilities */
  --color-red-950: #715959;

  --color-blackLight: #1D1D1B;
  --color-toRename: #715959;
  --color-contentBgBlack: #2A3631;

  /* fonts: provide valid font-family stacks so font-* utilities are generated */
  --font-bnpType: "BnppType", sans-serif;
  --font-bnpSansCondensedBold: "BnpSansCondensedBold", sans-serif;
  --font-bnpSansCondensedExtraBold: "BnpSansCondensedExtraBold", sans-serif;
  --font-bnpSansCondensedRegular: "BnpSansCondensedRegular", sans-serif;
  --font-bnpTypeBold: "BnppTypeBold", sans-serif;
  --font-bnppTypeRegular: "BnppTypeRegular", sans-serif;
  --font-bnpSans: "BnppSans", sans-serif;
  --font-bnppSansBold: "BnppSansBold", sans-serif;
  --font-openSans: "Open Sans", sans-serif;
  --font-openSansRegular: "OpenSansRegular", sans-serif;
  --font-openSansBold: "OpenSansBold", sans-serif;
  --font-helvicaNeue: "Helvetica Neue", sans-serif;

  /* text/size tokens */
  --text-2-5xl: 1.75rem;

  /* line heights */
  --leading-loose: 1.8;

  /* shadows */
  --shadow-card: 0px 8px 38px -28px rgba(8, 14, 71, 0.75);
  --shadow-main-color: 0px 4px 34px 0px rgba(22, 37, 171, 0.25);

  /* z index example */
  --z--1: -1;
}

/* COMPONENTS: prose + simple-quote (DEFAULT + md breakpoint) */
@layer components {
  .prose img { margin: 0; }

  .prose h2 {
    font-size: 26px;
    font-family: var(--font-bnpSansCondensedBold);
    line-height: 34px;
    letter-spacing: 0.26px;
    color: #626262;
    margin-top: 0; margin-bottom: 0; font-weight: unset;
  }
  .prose h3 {
    font-size: 20px;
    font-family: var(--font-bnpSansCondensedBold);
    line-height: 24px;
    color: #626262;
    margin-top: 0; margin-bottom: 0; font-weight: unset;
  }
  .prose h4 {
    font-size: 14px;
    font-family: "OpenSansBold";
    font-weight: bold;
    line-height: 26px;
    letter-spacing: 0.13px;
    color: #626262;
    margin-top: 0; margin-bottom: 0;
  }
  .prose p, .prose a, .prose i, .prose u, .prose strong, .prose li, .prose td {
    font-size: 14px;
    font-family: var(--font-openSansRegular);
    line-height: 26px;
    color: #626262;
  }
  .prose a { color: black; }
  .prose strong { font-family: var(--font-openSansBold); }

  .prose figure.image figcaption {
    font-size: 14px !important;
    font-family: var(--font-bnpSansCondensedRegular);
    line-height: 18px !important;
    letter-spacing: 0.17px;
    color: #626262;
    margin-top: 15px;
  }

  /* simple-quote (DEFAULT - quote-sm) */
  .simple-quote {
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 25px 25px 25px;
    padding-top: 5rem;
    font-size: 18px;
    font-family: var(--font-bnpSansCondensedRegular);
    line-height: 23px;
    letter-spacing: 0.24px;
  }
  .simple-quote blockquote {
    position: relative;
    color: #3c3145;
    border-left-width: 0;
    font-size: 20px;
    font-family: var(--font-bnpSansCondensedRegular);
    line-height: 26px;
    letter-spacing: 0.16px;
    padding: 0 !important;
    text-align: center;
  }
  .simple-quote blockquote::before {
    content: url("/svg/quotes.svg");
    position: absolute;
    top: -2.5rem;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 42px;
    height: 29px;
  }
  .simple-quote figcaption {
    margin-top: 26px;
    font-size: 16px;
    font-family: var(--font-bnpSansCondensedRegular);
    line-height: 20px;
    letter-spacing: 0.14px;
  }

  /* md breakpoint adjustments (mirrors your v3 `typography.md`) */
  @media (min-width: 768px) {
    .prose h2 { font-size: 30px; line-height: 36px; letter-spacing: 0.24px; }
    .prose h3 { font-size: 24px; line-height: 30px; }
    .prose h4 { font-size: 16px; line-height: 28px; }
    .prose h5 { font-size: 18px; line-height: 24px; }
    .prose p, .prose a, .prose i, .prose u, .prose strong, .prose li, .prose td {
      font-size: 16px; line-height: 28px;
    }
    .prose figure.image figcaption {
      font-size: 18px !important; line-height: 23px !important; margin-top: 20px;
    }

    .simple-quote {
      padding: 40px 80px 28px 80px;
      padding-top: 5rem;
    }
    .simple-quote blockquote {
      font-size: 24px;
      line-height: 30px;
      letter-spacing: 0.19px;
      padding: 0;
      text-align: center;
      color: #3c3145;
    }
    .simple-quote figcaption { margin-top: 26px; font-size: 18px; line-height: 23px; }
  }
}

/* KEYFRAMES + UTILITIES for animations */
@keyframes slide-r-in { 0% { opacity: 0; transform: translateX(-50%); } 100% { opacity: 1; transform: translateX(0); } }
@keyframes slide-l-in { 0% { opacity: 0; transform: translateX(50%); } 100% { opacity: 1; transform: translateX(0); } }

@layer utilities {
  .animate-slide-r { animation: slide-r-in 1s ease-in-out; }
  .animate-slide-l { animation: slide-l-in 1s ease-in-out; }

  /* bg-hero-image helper using a theme token */
  .bg-hero-image { background-image: url('/images/hero-image.jpg'); }
}