}
}

/* Process CSS - Reset */
@layer components {
.process-css {
& h2,
& h3,
& h4,
& p,
& ul,
& li {
margin: 0;
}
}

/* Responsive Typography - h2 */
.process-css h2 {
font-size: 30px;
line-height: 36px;
letter-spacing: 0.24px;

```
@media (min-width: 48rem) {
  font-size: 24px;
  line-height: 30px;
}
```

}

/* Additional responsive styles… */
