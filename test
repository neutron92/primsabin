[^\s<>"]*)?)', '\1|||', 'gi'),
      '\|\|\|'
    ) as extracted_url
  FROM your_table_name
  WHERE body ~ 'https?://[^\s<>"]+\.(?:jpg|jpeg|png|gif|webp|svg|bmp|tiff)(?:\?[^\s<>"]*)?'
),
all_images AS (
  -- Combine existing image columns with extracted URLs
  SELECT id, image1 as image_url, 1 as source_type FROM your_table_name WHERE image1 IS NOT NULL
  UNION ALL
  SELECT id, image2 as image_url, 2 as source_type FROM your_table_name WHERE image2 IS NOT NULL
  UNION ALL  
  SELECT id, image3 as image_url, 3 as source_type FROM your_table_name WHERE image3 IS NOT NULL
  UNION ALL
  SELECT id, extracted_url as image_url, 4 as source_type 
  FROM extracted_urls 
  WHERE extracted_url != '' AND extracted_url IS NOT NULL
)
SELECT 
  id as post_id,
  array_agg(image_url ORDER BY source_type) as all_image_urls,
  count(*) as total_images
FROM all_images
GROUP BY id
ORDER BY id;

